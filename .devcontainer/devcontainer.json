{
  "name": "Computor Python courses (external AI provider)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm@sha256:7876580dc67fd460fd962f004cbeb480027e9bbc0657096f1087db11f9eaff39",
  "remoteUser": "vscode",
  "postCreateCommand": "python -m pip install --require-hashes -r requirements.lock",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "computor-org.computor", "computor-org.hackl"],
      "settings": {
        "hackl.engine.enabled": false,
        "hackl.autocomplete.enabled": false,
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "files.exclude": {"**/__pycache__": true}
      }
    }
  }
}
